generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  REQUESTER
  VOLUNTEER
  BOTH
  ADMIN
}

enum OpportunityType {
  ONE_TIME
  RECURRING
  EVENT
}

enum OpportunityStatus {
  DRAFT
  OPEN
  PAUSED
  FILLED
  PROCESSING
  CANCELLED
  COMPLETED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  WAITLISTED
  REJECTED
  WITHDRAWN
}

enum OrganizationType {
  INDIVIDUAL
  VOLUNTARY_GROUP
  SMALL_BUSINESS
  NPO
  GENERAL_ASSOCIATION
  CORPORATION
  SCHOOL
  COMMUNITY_GROUP
  MUNICIPAL
}

// ─── Auth (NextAuth v5 adapter tables) ───────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Domain ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(VOLUNTEER)
  locale        String    @default("ja")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  profile               VolunteerProfile?
  organization          Organization?
  opportunities         Opportunity[]
  applications          Application[]
  aiInteractions        AiInteraction[]
  aiAssistantFeedback   AiAssistantFeedback[]
  notifications         Notification[]
  eventUpdates          EventUpdate[]
  sentEventMessages     EventMessage[]    @relation("SentEventMessages")
  receivedEventMessages EventMessage[]    @relation("ReceivedEventMessages")
  experienceShares     ExperienceShare[]
  postEventReflections PostEventReflection[]
  skillBadges          VolunteerSkillBadge[]
}

model VolunteerProfile {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  displayName               String?
  email                     String?
  phone                     String?
  bio                       String?  @db.Text
  skills                    String[] @default([])
  interests                 String[] @default([])
  languages                 String[] @default([])
  availability              String?
  availabilitySlots         String[] @default([])
  preferredTaskTypes        String[] @default([])
  preferredEnvironmentStyle String   @default("either")
  emailNotificationsEnabled Boolean  @default(true)
  inAppNotificationsEnabled Boolean  @default(true)
  reminder3DaysEnabled      Boolean  @default(true)
  reminder1DayEnabled       Boolean  @default(true)
  reminderSameDayEnabled    Boolean  @default(true)
  profileCompleted          Boolean  @default(false)
  prefecture                String?
  city                      String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id                        String           @id @default(cuid())
  userId                    String           @unique
  name                      String
  displayName               String?
  nameJa                    String?
  nameKana                  String?
  nameEn                    String?
  email                     String?
  phone                     String?
  contactName               String?
  type                      OrganizationType @default(INDIVIDUAL)
  representativeName        String?
  purpose                   String?          @db.Text
  description               String?          @db.Text
  activityAreas             String[]         @default([])
  activityRegions           String[]         @default([])
  environmentStyle          String           @default("mixed")
  prefecture                String?
  city                      String?
  address                   String?
  googleMapsUrl             String?
  publicEmail               String?
  publicPhone               String?
  contactFormUrl            String?
  website                   String?
  snsLinks                  String[]         @default([])
  founded                   String?
  recruitmentStatus         String           @default("recruiting")
  hasWaterDispenser         Boolean          @default(false)
  hasRestRoom               Boolean          @default(false)
  hasAirConditioning        Boolean          @default(false)
  activitySpaceSize         String?
  profileImageUrl           String?
  workspaceImageUrls        String[]         @default([])
  certificationStatus       String           @default("uncertified")
  certificationSource       String?
  certifiedAt               DateTime?
  certificationSubmittedAt  DateTime?
  certificationReviewedAt   DateTime?
  certificationReviewNote   String?          @db.Text
  managerPhone              String?
  managerLegalName          String?
  identityDocumentNote      String?          @db.Text
  managerAddress            String?
  isLocationPublic          Boolean          @default(false)
  contactPersonName         String?
  contactPersonRole         String?
  contactPersonPhone        String?
  contactPersonEmail        String?
  antiSocialForcesConfirmed Boolean          @default(false)
  termsAccepted             Boolean          @default(false)
  legalEntityType           String?
  corporateNumber           String?
  legalName                 String?
  legalAddress              String?
  registrationDocumentUrl   String?
  bylawsUrl                 String?
  profileCompleted          Boolean          @default(false)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities        Opportunity[]
  reviewedApplications Application[] @relation("ReviewedApplications")
}

model Opportunity {
  id                         String            @id @default(cuid())
  title                      String
  titleJa                    String?
  shortDescription           String?
  description                String            @db.Text
  descriptionJa              String?           @db.Text
  type                       OpportunityType   @default(ONE_TIME)
  status                     OpportunityStatus @default(DRAFT)
  category                   String?
  tags                       String[]          @default([])
  taskTypeColor              String?
  environmentShape           String?
  physicalEffort             String            @default("medium")
  mentalEffort               String            @default("medium")
  skills                     String[]
  prefecture                 String?
  city                       String?
  address                    String?
  googleMapsUrl              String?
  latitude                   Decimal?          @db.Decimal(10, 7)
  longitude                  Decimal?          @db.Decimal(10, 7)
  startAt                    DateTime?
  endAt                      DateTime?
  arrivalTime                DateTime?
  durationMinutes            Int?
  recurrenceRule             String?
  volunteersNeeded           Int               @default(1)
  maxApplicants              Int?
  allowWaitlist              Boolean           @default(true)
  allowMultipleTaskSelection Boolean           @default(false)
  taskFlow                   Json              @default("[]")
  customFields               Json              @default("{}")
  instructions               String?           @db.Text
  toolsProvided              String[]          @default([])
  thingsToBring              String[]          @default([])
  arrivalGuidance            String?           @db.Text
  firstLandmarkDescription   String?           @db.Text
  firstLandmarkImageUrl      String?
  firstContactName           String?
  firstContactRole           String?
  firstContactImageUrl       String?
  coverImageUrl              String?
  workspaceImageUrls         String[]          @default([])
  workspace3dEmbedUrl        String?
  preApplicationQuestions    Json              @default("[]")
  withdrawalCutoffHours      Int               @default(24)
  aiTemplateUsed             String?
  requesterId                String
  organizationId             String?
  aiDrafted                  Boolean           @default(false)
  publishedAt                DateTime?
  completedAt                DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  requester     User           @relation(fields: [requesterId], references: [id])
  organization  Organization?  @relation(fields: [organizationId], references: [id])
  applications  Application[]
  notifications Notification[]
  eventUpdates  EventUpdate[]
  eventMessages EventMessage[]
  experienceShares ExperienceShare[]
  postEventReflections PostEventReflection[]
}

model Application {
  id                      String            @id @default(cuid())
  opportunityId           String
  volunteerId             String
  status                  ApplicationStatus @default(PENDING)
  selectedTaskItems       Json              @default("[]")
  confirmedTimeCommitment Boolean           @default(false)
  skillTags               String[]          @default([])
  experienceNote          String?           @db.Text
  message                 String?           @db.Text
  questionAnswers         Json              @default("{}")
  waitlistPosition        Int?
  reviewedByEmployerId    String?
  participantGroup        String?
  participantRole         String            @default("MEMBER")
  accessLevel             String            @default("STANDARD")
  organizerNote           String?           @db.Text
  rejectionReason         String?           @db.Text
  attendanceStatus        String            @default("UNKNOWN")
  checkedInAt             DateTime?
  checkinMethod           String?
  matchScore              Float?
  aiRecommended           Boolean           @default(false)
  reviewedAt              DateTime?
  withdrawnAt             DateTime?
  withdrawalReason        String?           @db.Text
  completedAt             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  opportunity        Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  volunteer          User           @relation(fields: [volunteerId], references: [id])
  reviewedByEmployer Organization?  @relation("ReviewedApplications", fields: [reviewedByEmployerId], references: [id], onDelete: SetNull)
  booking            Booking?
  notifications      Notification[]
  eventMessages      EventMessage[]
  experienceShare    ExperienceShare?
  postEventReflection PostEventReflection?

  @@unique([opportunityId, volunteerId])
}

model PostEventReflection {
  id                    String   @id @default(cuid())
  applicationId         String   @unique
  userId                String
  opportunityId         String
  durationMinutes       Int
  accomplishmentSummary String   @db.Text
  shareCardText         String   @db.Text
  badges                Json     @default("[]")
  taskClarityRating     Int?
  preparationRating     Int?
  timeWellSpentRating   Int?
  feedbackComment       String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([opportunityId])
}

model VolunteerSkillBadge {
  id           String   @id @default(cuid())
  userId       String
  badgeKey     String
  name         String
  icon         String
  description  String   @db.Text
  earnedCount  Int      @default(1)
  firstEarnedAt DateTime @default(now())
  lastEarnedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey])
  @@index([badgeKey])
}

model ExperienceShare {
  id            String   @id @default(cuid())
  authorId      String
  opportunityId String
  applicationId String?  @unique
  title         String
  body          String   @db.Text
  imageUrl      String?
  tags          String[] @default([])
  rating        Int?
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([opportunityId])
  @@index([authorId])
  @@index([createdAt])
}

model Notification {
  id            String    @id @default(cuid())
  userId        String
  opportunityId String?
  applicationId String?
  type          String
  title         String
  body          String    @db.Text
  channel       String    @default("IN_APP")
  metadata      Json      @default("{}")
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model EventUpdate {
  id                String   @id @default(cuid())
  opportunityId     String
  organizerId       String
  type              String   @default("GENERAL")
  message           String   @db.Text
  highlightedDetail String?  @db.Text
  createdAt         DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  organizer   User        @relation(fields: [organizerId], references: [id], onDelete: Cascade)
}

model EventMessage {
  id            String    @id @default(cuid())
  opportunityId String
  applicationId String
  senderId      String
  recipientId   String
  body          String    @db.Text
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sender      User        @relation("SentEventMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User        @relation("ReceivedEventMessages", fields: [recipientId], references: [id], onDelete: Cascade)
}

model Booking {
  id             String    @id @default(cuid())
  applicationId  String    @unique
  confirmedAt    DateTime  @default(now())
  reminderSentAt DateTime?
  notes          String?   @db.Text

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model AiInteraction {
  id            String   @id @default(cuid())
  userId        String
  opportunityId String?
  type          String
  inputTokens   Int?
  outputTokens  Int?
  cost          Float?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AiAssistantFeedback {
  id         String   @id @default(cuid())
  userId     String
  flowType   String
  stepId     String
  locale     String
  userAnswer String?  @db.Text
  botMessage String?  @db.Text
  context    Json     @default("{}")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([flowType])
}
