generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  REQUESTER
  VOLUNTEER
  BOTH
  ADMIN
}

enum OpportunityType {
  ONE_TIME
  RECURRING
  EVENT
}

enum OpportunityStatus {
  DRAFT
  OPEN
  FILLED
  CANCELLED
  COMPLETED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum OrganizationType {
  INDIVIDUAL
  SMALL_BUSINESS
  NPO
  COMMUNITY_GROUP
  MUNICIPAL
}

// ─── Auth (NextAuth v5 adapter tables) ───────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Domain ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(VOLUNTEER)
  locale        String    @default("ja")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  profile        VolunteerProfile?
  organization   Organization?
  opportunities  Opportunity[]
  applications   Application[]
  aiInteractions AiInteraction[]
}

model VolunteerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  bio          String?  @db.Text
  skills       String[]
  languages    String[]
  availability String?
  prefecture   String?
  city         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id          String           @id @default(cuid())
  userId      String           @unique
  name        String
  nameJa      String?
  type        OrganizationType @default(INDIVIDUAL)
  description String?          @db.Text
  prefecture  String?
  city        String?
  address     String?
  website     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
}

model Opportunity {
  id               String            @id @default(cuid())
  title            String
  titleJa          String?
  description      String            @db.Text
  descriptionJa    String?           @db.Text
  type             OpportunityType   @default(ONE_TIME)
  status           OpportunityStatus @default(DRAFT)
  skills           String[]
  prefecture       String?
  city             String?
  address          String?
  startAt          DateTime?
  endAt            DateTime?
  recurrenceRule   String?
  volunteersNeeded Int               @default(1)
  requesterId      String
  organizationId   String?
  aiDrafted        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  requester    User          @relation(fields: [requesterId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  applications Application[]
}

model Application {
  id            String            @id @default(cuid())
  opportunityId String
  volunteerId   String
  status        ApplicationStatus @default(PENDING)
  message       String?           @db.Text
  matchScore    Float?
  aiRecommended Boolean           @default(false)
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  volunteer   User        @relation(fields: [volunteerId], references: [id])
  booking     Booking?

  @@unique([opportunityId, volunteerId])
}

model Booking {
  id             String    @id @default(cuid())
  applicationId  String    @unique
  confirmedAt    DateTime  @default(now())
  reminderSentAt DateTime?
  notes          String?   @db.Text

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model AiInteraction {
  id            String   @id @default(cuid())
  userId        String
  opportunityId String?
  type          String
  inputTokens   Int?
  outputTokens  Int?
  cost          Float?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
