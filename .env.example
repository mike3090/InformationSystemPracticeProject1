# ── Database ──────────────────────────────────────────────────────────────────
# Neon, Supabase, or any PostgreSQL connection string
DATABASE_URL="example-postgresql-connection-string"

# ── NextAuth v5 ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="example-nextauth-secret"

# Google OAuth  (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
AUTH_URL=http://localhost:3000

# Magic link email via Resend (https://resend.com/)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@yourdomain.com"

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIza..."

# Set to "true" during local UI development to skip real Gemini calls.
# All agents return realistic mock data instead. Never set this in production.
MOCK_AI="false"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
